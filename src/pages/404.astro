---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page Not Found | Country Roofing & Construction LLC"
  description="The page you're looking for doesn't exist. Return to Country Roofing & Construction LLC's homepage."
  canonical="https://countryroofingandconstruction.com/404"
>
  <Header />

  <main id="main-content">

  <section class="not-found">
    <div class="container text-center">
      <h1>404</h1>
      <p class="not-found-sub">Page Not Found</p>
      <p class="not-found-text">Sorry, the page you're looking for doesn't exist or has been moved.</p>
      <div class="not-found-actions">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/contact" class="btn btn--accent">Contact Us</a>
      </div>
    </div>
  </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: 4rem 0;
  }

  .not-found h1 {
    font-size: clamp(5rem, 15vw, 10rem);
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 0.5rem;
    opacity: 0.2;
  }

  .not-found-sub {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .not-found-text {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
