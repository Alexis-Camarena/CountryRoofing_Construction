---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact Us | Country Roofing & Construction LLC — (269) 303-3604"
  description="Get a free roofing estimate from Country Roofing & Construction LLC. Call (269) 303-3604 or fill out our contact form. Serving Kalamazoo, Barry, Allegan & Van Buren Counties."
  canonical="https://countryroofingandconstruction.com/contact"
  ogTitle="Contact Country Roofing & Construction LLC"
  ogDescription="Need roofing help? Call (269) 303-3604 or email us for a free estimate. Serving West Michigan."
>
  <Header />

  <main id="main-content">

  <!-- Page Hero -->
  <section class="hero-var hero--contact">
  <div class="hero__overlay hero__overlay--contact"></div>

  <div class="container">
    <div class="hero__content hero__content--center">


      <h1 class="hero__title">
        CONTACT US
      </h1>

      <p class="hero__description">
        Have a question, need an estimate, or want to discuss your project?
        We're here to help.
      </p>
    </div>
  </div>
</section>

  <!-- Contact Section -->
  <section class="section">
    <div class="container contact-grid">
      <!-- Contact Info -->
      <div class="contact-info">
        <h2>Get In Touch</h2>

        <div class="info-card">
          <div class="info-icon">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          </div>
          <div>
            <h3>Call Us</h3>
            <a href="tel:+12693033604">(269) 303-3604</a>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <h3>Email Us</h3>
            <a href="mailto:269country@gmail.com">269country@gmail.com</a>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h3>Service Area</h3>
            <p>Kalamazoo, MI</p>
            <p class="areas">Kalamazoo County · Barry County · Allegan County · Van Buren County</p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <div>
            <h3>Follow Us</h3>
            <a href="https://facebook.com/profile.php?id=61555016512639" target="_blank" rel="noopener noreferrer">Facebook</a>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-wrap">
        <h2>Have Questions?</h2>
        <p>Fill out the form below and we'll get back to you as soon as possible.</p>
        <form class="contact-form" action="https://formsubmit.co/269country@gmail.com" method="POST">
          <!-- Anti-spam honeypot -->
          <input type="text" name="_honey" style="display:none" aria-hidden="true" tabindex="-1" />
          <!-- Disable captcha page -->
          <input type="hidden" name="_captcha" value="false" />
          <!-- Redirect after submission -->
          <input type="hidden" name="_next" value="https://countryroofingandconstruction.com/contact?sent=true" />
          <!-- Subject line -->
          <input type="hidden" name="_subject" value="New Contact Form Submission — Country Roofing" />

          <div class="form-row">
            <div class="form-group">
              <label for="firstName">First Name</label>
              <input type="text" id="firstName" name="firstName" placeholder="John" autocomplete="given-name" />
            </div>
            <div class="form-group">
              <label for="lastName">Last Name</label>
              <input type="text" id="lastName" name="lastName" placeholder="Doe" autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" autocomplete="email"/>
            </div>

            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" placeholder="(269) 555-1234" autocomplete="tel"/>
            </div>
          </div>

          <div class="form-group">
            <label for="message">Message <span class="required">*</span></label>
            <textarea id="message" name="message" rows="5" placeholder="Tell us about your project in a few words..." required></textarea>
          </div>


          <div class="sms-consent" id="smsConsentContainer" hidden>
            <label class="sms-consent__label">
              <input
                type="checkbox"
                id="smsConsent"
                name="smsConsent"
                value="Yes"
                required
              />

              <span>
                I agree to receive text messages from Country Roofing &amp; Construction
                LLC regarding my inquiry, appointment scheduling, project updates, and
                customer service. Message frequency varies. Message and data rates may
                apply. Reply STOP to opt out or HELP for assistance. Consent is not a
                condition of purchase. View our
                <a href="/privacy-policy">Privacy Policy</a>
                and
                <a href="/terms-of-service">Terms of Service</a>.
              </span>
            </label>
          </div>

          <button type="submit" class="btn btn--cta btn--full">Submit</button>
        </form>

        <div id="success-message" class="success-message" style="display:none;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <p>Thank you! Your message has been sent. We'll get back to you shortly.</p>
        </div>
      </div>
    </div>
  </section>

  </main>

  <Footer />
</BaseLayout>

<script>
  // Success message
  if (window.location.search.includes('sent=true')) {
    const msg = document.getElementById('success-message');

    if (msg) {
      msg.style.display = 'flex';
    }
  }

  const form = document.querySelector<HTMLFormElement>('.contact-form');

  const email = document.getElementById('email') as HTMLInputElement;
  const phone = document.getElementById('phone') as HTMLInputElement;

  const smsContainer = document.getElementById(
    'smsConsentContainer'
  ) as HTMLElement;

  const smsConsent = document.getElementById(
    'smsConsent'
  ) as HTMLInputElement;

  function updateSMSVisibility() {
    const hasPhone = phone.value.trim() !== '';

    smsContainer.hidden = !hasPhone;
    smsConsent.required = hasPhone;

    if (!hasPhone) {
      smsConsent.checked = false;
    }
  }

  phone.addEventListener('input', updateSMSVisibility);

  form?.addEventListener('submit', (event) => {
    const hasEmail = email.value.trim() !== '';
    const hasPhone = phone.value.trim() !== '';

    if (!hasEmail && !hasPhone) {
      event.preventDefault();

      alert('Please provide either an email address or phone number.');

      return;
    }

    updateSMSVisibility();
  });

  updateSMSVisibility();
</script>

<style>
  
.hero--contact {
  background-image: url('/images/house_8.jpg'); /* change to whichever photo you like */
  background-size: cover;
  background-position: 80% center;
  background-size: 100% auto;
  background-repeat: no-repeat;
  background-color: #0b1728;
}

.hero__overlay--contact {
  background:
    radial-gradient(
      circle at center,
      rgba(5, 12, 24,.45) 0%,
      rgba(5, 12, 30, .65) 40%,
      rgba(5, 12, 24, 0.82) 100%
    );
}



.hero__content--center {
  max-width: 760px;
  margin: 0 auto;
  text-align: center;
}

.hero__content--center .hero__description {
  margin-left: auto;
  margin-right: auto;
}

.hero__content--center .hero__actions {
  justify-content: center;
}

  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 4rem;
  }

  .contact-info h2,
  .contact-form-wrap h2 {
    margin-bottom: 1.5rem;
  }

  .contact-form-wrap > p {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  /* Info Cards */
  .info-card {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem;
    background: var(--color-light);
    border-radius: 10px;
  }

  .info-icon {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .info-card h3 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .info-card a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .info-card p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .areas {
    font-size: 0.825rem !important;
    margin-top: 0.25rem;
  }

  /* Form */
  .required {
    color: #e53e3e;
  }

  .btn--full {
    width: 100%;
    padding: 1rem;
    font-size: 1.05rem;
  }

  .success-message {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-radius: 8px;
    color: #166534;
  }

  .success-message p {
    font-weight: 500;
  }


  /* SMS Styling */

  .sms-consent {
    margin: 1.75rem 0;
  }

  .sms-consent__label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
  }

  .sms-consent__label input {
    margin-top: 0.3rem;
    flex-shrink: 0;
  }

  .sms-consent__label span {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .sms-consent__label a {
    font-weight: 600;
  }

  .contact-note {
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .page-hero {
      padding: 6rem 0 3rem;
    }
  }

  @media (max-width: 480px) {
    .page-hero {
      padding: 4.5rem 0 2.5rem;
    }

    .info-card {
      padding: 1rem;
    }
  }
</style>
