---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const commonProblems = [
  'Leaking roof',
  'Missing or lifted shingles',
  'Storm or wind damage',
  'Older roof replacement',
  'Commercial roof concerns',
  'Siding, gutters, and exterior updates',
];

const services = [
  {
    problem: 'Leaking roof',
    eyebrow: 'Fast help',
    title: 'Roof Repair',
    description: 'When something looks off, you do not always need a full replacement. We inspect the issue, explain what is going on, and repair what needs attention.',
    bullets: ['Leak inspections', 'Flashing repairs', 'Shingle replacement', 'Problem areas after storms']
  },
  {
    problem: 'Missing or lifted shingles',
    eyebrow: 'Homes',
    title: 'Residential Roofing',
    description: 'Roofing for Southwest Michigan homes, from small repairs to full replacements. We help homeowners understand what their roof needs and what should be handled before Michigan weather makes it worse.',
    bullets: ['Roof inspections', 'Roof repairs', 'Full roof replacements', 'Asphalt shingles']
  },
  {
    problem: 'Storm or wind damage',
    eyebrow: 'After bad weather',
    title: 'Storm Damage Repair',
    description: 'Wind, hail, and heavy rain can leave behind damage that is not always obvious from the ground. We check the roof and guide you through the next steps.',
    bullets: ['Wind damage', 'Hail damage', 'Emergency repairs', 'Insurance claim support']
  },
  {
    problem: 'Older roof replacement',
    eyebrow: 'Full replacement',
    title: 'Roof Replacement',
    description: 'When a roof is at the end of its life, we install a system built to protect the home, improve curb appeal, and stand up to Southwest Michigan seasons.',
    bullets: ['Tear-off and replacement', 'Material selection', 'Clean job sites', 'Final walkthrough']
  },
  {
    problem: 'Commercial roof concerns',
    eyebrow: 'Businesses',
    title: 'Commercial Roofing',
    description: 'Roofing support for local businesses and commercial properties that need dependable work, clear communication, and a crew that understands timelines matter.',
    bullets: ['Commercial roof repairs', 'Replacement planning', 'Leak prevention', 'Maintenance guidance']
  },
  {
    problem: 'Siding, gutters, and exterior updates',
    eyebrow: 'Exterior work',
    title: 'Siding, Gutters & Home Renovations',
    description: 'Roofing is often one part of a larger exterior project. We can help with siding, gutters, and renovation work that protects and finishes the property.',
    bullets: ['Siding work', 'Gutter installation', 'Exterior upgrades', 'Home renovation support']
  }
];

const materials = [
  'Asphalt shingles',
  'Metal roofing',
  'Tile roofing',
  'Siding and gutters',
];

const faqs = [
  {
    q: 'What services does Country Roofing & Construction LLC offer?',
    a: 'Country Roofing & Construction LLC provides residential roofing, commercial roofing, roof repair, storm damage repair, roof replacement, siding, gutters, and home renovation support.'
  },
  {
    q: 'Where does Country Roofing & Construction LLC provide roofing services?',
    a: 'Country Roofing & Construction LLC is based in Kalamazoo, MI and serves Kalamazoo County, Barry County, Allegan County, Van Buren County, and surrounding Southwest Michigan areas.'
  },
  {
    q: 'Do you offer roof repairs or only full roof replacements?',
    a: 'We handle both roof repairs and full roof replacements. After looking at the roof, we can explain whether a repair makes sense or whether replacement is the better long-term option.'
  },
  {
    q: 'Can you help with storm damage?',
    a: 'Yes. We help with roof damage caused by wind, hail, heavy rain, missing shingles, and other storm-related issues. We can also provide guidance if an insurance claim may be involved.'
  },
  {
    q: 'What roofing materials do you work with?',
    a: 'We work with asphalt shingles, metal roofing, tile roofing, siding, and gutters. Our team can help you choose materials based on budget, style, and performance needs.'
  },
  {
    q: 'Is Country Roofing & Construction LLC licensed and insured?',
    a: 'Yes. Country Roofing & Construction LLC is licensed and insured to provide roofing and construction services in Southwest Michigan.'
  },
  {
    q: 'Do you provide free estimates?',
    a: 'Yes. Country Roofing & Construction LLC provides free estimates. You can request an estimate online or call (269) 303-3604.'
  },
  {
    q: 'How long does a roofing project take?',
    a: 'The timeline depends on the size of the roof, the type of work, materials, and weather. Smaller repairs may be completed quickly, while full roof replacements require more planning and coordination.'
  },
  {
    q: 'How can I schedule a consultation?',
    a: 'You can request an estimate online or call Country Roofing & Construction LLC at (269) 303-3604 to discuss your roofing or exterior project.'
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<BaseLayout
  title="Roofing Services in Kalamazoo & Southwest Michigan | Country Roofing & Construction LLC"
  description="Roofing services in Kalamazoo and Southwest Michigan. Country Roofing & Construction LLC handles roof repair, roof replacement, storm damage repair, commercial roofing, siding, gutters, and home renovations."
  canonical="https://countryroofingandconstruction.com/services"
  ogTitle="Roofing Services | Country Roofing & Construction LLC"
  ogDescription="Roof repairs, roof replacements, storm damage repair, commercial roofing, siding, gutters, and exterior work across Kalamazoo, Barry, Allegan, and Van Buren Counties."
  extraSchema={faqSchema}
>
  <Header />

  <main id="main-content">
    <!-- Services Hero -->
    <!-- Services Hero -->
  <section class="hero hero--services">
    <div class="container services-hero__grid">
      <div class="hero__content">
        <p class="hero__eyebrow">
          Roof Repair • Replacement • Storm Damage
        </p>

        <h1 class="hero__title">
          Roofing &amp; Exterior Services
        </h1>

        <p class="hero__description">
          Explore our roofing and exterior services, from small repairs to
          complete replacements. Not sure what you need? Start with the common
          problems below and we'll help you find the right solution.
        </p>

        <div class="hero__actions">
          <a href="/quote-estimator" class="btn btn--cta">
            Get Free Estimate
          </a>

          <a href="#services-list" class="btn btn--outline">
            Explore Services
          </a>
        </div>
      </div>

      <div class="services-hero__map">
        <img
          src="/images/finalmap.svg"
          class="hero-map"
          alt="Country Roofing service area map"
        />
      </div>
    </div>
  </section>

  <!-- Interactive Services -->
  <section class="section problems-section" id="services-list">
    <div class="container">
      <div class="section-header section-header--left">
        <p class="eyebrow eyebrow--dark">Why people call us</p>
        <h2>Most homeowners do not start with a service name. They start with a problem.</h2>
        <p>Choose the option that sounds closest to what you are experiencing.</p>
      </div>

      <div class="problem-tabs" role="tablist" aria-label="Roofing problems">
        {services.map((service, i) => (
          <button
            class:list={['problem-tab', { 'problem-tab--active': i === 0 }]}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`service-panel-${i}`}
            data-service-tab={i}
          >
            <span></span>
            <strong>{service.problem}</strong>
            <span class="problem-tab__arrow">↓</span>
          </button>
        ))}
      </div>
    
      <div class="service-panels">
        {services.map((service, i) => (
          <article
            class:list={['service-panel', { 'service-panel--active': i === 0 }]}
            id={`service-panel-${i}`}
            role="tabpanel"
            data-service-panel={i}
            hidden={i !== 0}
          >
            <div class="service-panel__left">
              <p class="eyebrow eyebrow--dark">{service.eyebrow}</p>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>

            <div class="service-panel__right">
              <h4>How we help</h4>

              <ul>
                {service.bullets.map(bullet => (
                  <li>{bullet}</li>
                ))}
              </ul>

              <div class="service-panel__actions">
                <a href="/quote-estimator" class="btn btn--cta">Get A Free Estimate</a>
                <a href="tel:+12693033604" class="btn btn--outline-dark">Call (269) 303-3604</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

    <!-- Materials -->
    <!-- <section class="section--light">
      <div class="container materials-section">
        <div class="materials-text">
          <p class="eyebrow eyebrow--dark">Materials and guidance</p>
          <h2>We help you choose what makes sense for your roof.</h2>
          <p>
            Materials should fit the home, the budget, and the way Michigan weather hits the property. Our team can walk through the options and explain what is practical before the work begins.
          </p>

          <ul class="materials-list">
            {materials.map(material => (
              <li>{material}</li>
            ))}
          </ul>

          <a href="/quote-estimator" class="btn btn--primary mt-3">Get A Free Estimate</a>
        </div>

        <div class="materials-note">
          <h3>Not sure what you need?</h3>
          <p>
            That is normal. A lot of roofing projects start with a leak, a missing shingle, or storm damage that needs a closer look. We can help you figure out whether it is a repair, replacement, or something in between.
          </p>
          <a href="tel:+12693033604">Call (269) 303-3604</a>
        </div>
      </div>
    </section> -->

    <!-- FAQ -->
    <section class="section section--light">
      <div class="container faq-section">
        <div class="section-header section-header--left">
          <p class="eyebrow eyebrow--dark">Questions homeowners ask</p>
          <h2>Roofing service FAQ</h2>
        </div>

        <div class="faq-list">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-question">{faq.q}</summary>
              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="services-cta">
      <div class="container services-cta__inner">
        <div>
          <p class="eyebrow">Ready when you are</p>
          <h2>Start with a quick estimate or a call.</h2>
          <p>Tell us what is going on with your roof or exterior project and we will help you figure out the next step.</p>
        </div>

        <div class="services-cta__actions">
          <a href="/quote-estimator" class="btn btn--cta">Request Free Estimate</a>
          <a href="tel:+12693033604" class="btn btn--outline">Call (269) 303-3604</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('[data-service-tab]');
  const panels = document.querySelectorAll('[data-service-panel]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const selectedIndex = tab.getAttribute('data-service-tab');

      tabs.forEach(item => {
        item.classList.remove('problem-tab--active');
        item.setAttribute('aria-selected', 'false');
      });

      panels.forEach(panel => {
        panel.classList.remove('service-panel--active');
        // panel.hidden = true;
      });

      tab.classList.add('problem-tab--active');
      tab.setAttribute('aria-selected', 'true');

      const selectedPanel = document.querySelector(
        `[data-service-panel="${selectedIndex}"]`
      );

      if (selectedPanel) {
        // selectedPanel.hidden = false;
        selectedPanel.classList.add('service-panel--active');
      }
    });
  });
</script>

<style>
  .eyebrow {
    color: var(--color-primary-light);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  .eyebrow--dark {
    color: var(--color-accent);
  }

  .section-header--left {
    text-align: left;
    max-width: 1080px;
    margin-left: 0;
  }

  .section-header--left p:not(.eyebrow) {
    margin-left: 0;
  }

  /* Services Hero */
  .hero--services {
  background:
    radial-gradient(
      circle at 78% 42%,
      rgba(104, 136, 173, 0.22) 0%,
      rgba(65, 116, 186, 0.12) 28%,
      transparent 55%
    ),
    linear-gradient(
      90deg,
      #050c18 0%,
      #081426 28%,
      #102744 55%,
      #284669 78%,
      #3f5f85 100%
    );
}

  .services-hero__grid {
    position: relative;
    width: 100%;
    min-height: inherit;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(480px, 0.95fr);
    align-items: center;
    gap: 2rem;
  }

  .services-hero__map {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: 50%;
    right: calc((100vw - 100%) / -2);
    overflow: hidden;
    pointer-events: none;
  }

  .hero-map {
    position: absolute;
    top: 48%;
    left: 10%;
    width: auto;
    height: 116%;
    max-width: none;
    transform: translateY(-50%);
    object-fit: contain;
    opacity: 0.94;
    filter:
      drop-shadow(0 0 12px rgba(65, 116, 186, 0.22))
      drop-shadow(0 0 28px rgba(65, 116, 186, 0.12));
  }

  

  /* Problem Section */
  .problems-section {
    background: var(--color-white);
  }

  .problems-section .section-header {
    margin-bottom: 2.5rem;
  }

  .problems-section .section-header > p:not(.eyebrow) {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    margin-top: 1rem;
  }

  .problem-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 2rem;
    margin-bottom: 3rem;
  }

  .problem-tab {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 76px;
    padding: 1rem 1.25rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
    cursor: pointer;
    text-align: left;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .problem-tab:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary-light);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.09);
  }

  .problem-tab > span:first-child {
    color: var(--color-primary-light);
    font-size: 1.15rem;
    font-weight: 900;
  }

  .problem-tab strong {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.35;
  }

  .problem-tab__arrow {
    color: var(--color-primary-light);
    font-size: 1.15rem;
    transition: transform 0.2s ease;
  }

  .problem-tab--active {
    color: var(--color-white);
    background: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 14px 32px rgba(30, 58, 95, 0.22);
  }

  .problem-tab--active > span:first-child,
  .problem-tab--active .problem-tab__arrow {
    color: var(--color-white);
  }

  .problem-tab--active .problem-tab__arrow {
    transform: rotate(180deg);
  }


  /* Services Section */
  .service-panels {
    position: relative;
  }

  .service-panel {
    display: none;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: 3rem;
    align-items: stretch;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: clamp(2rem, 4vw, 3rem);
    box-shadow: 0 20px 48px rgba(15, 23, 42, 0.09);
  }

  .service-panel--active {
    display: grid;
    animation: servicePanelFade 0.25s ease;
  }

  .service-panel__left {
    padding-right: 2rem;
  }

  .service-panel__left h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .service-panel__left > p:not(.eyebrow) {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.75;
    max-width: 680px;
  }

  .service-panel__right {
    border-left: 1px solid var(--color-border);
    padding-left: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .service-panel__right h4 {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .service-panel__right ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem 1.5rem;
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .service-panel__right li {
    position: relative;
    padding-left: 1.7rem;
    color: var(--color-text);
    font-weight: 600;
  }

  .service-panel__right li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary-light);
    font-weight: 900;
  }

  .service-panel__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: auto;
  }

  /* Button Styles */
  .btn--outline-dark {
    color: var(--color-primary);
    background: transparent;
    border: 2px solid var(--color-primary);
  }

  .btn--outline-dark:hover {
    color: var(--color-white);
    background: var(--color-primary);
  }

  /* Motion OnClick */
  @keyframes servicePanelFade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  /* Materials Section */
/* 
  .materials-section {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(300px, 0.75fr);
    gap: 3rem;
    padding-top: 2rem;
    align-items: center;
  }

  .materials-text p:not(.eyebrow) {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    margin-top: 1rem;
  }


  .materials-note {
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: 18px;
    padding: 2rem;
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.16);
  }

  .materials-note h3 {
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .materials-note p {
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 1rem;
  }

  .materials-note a {
    color: var(--color-white);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  } */



  /* Frequently Asked Questions Section */
  .faq-section {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 3rem;
    align-items: start;
  }

  .faq-list {
    width: 100%;
  }

  .faq-item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .faq-question {
    padding: 1.1rem 1.25rem;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    color: var(--color-primary);
    font-size: 1.4rem;
    font-weight: 400;
    margin-left: 1rem;
  }

  .faq-item[open] .faq-question::after {
    content: '−';
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem;
  }

  .faq-answer p {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .services-cta {
    background: linear-gradient(135deg, var(--color-primary), var(--color-dark));
    color: var(--color-white);
    padding: 4.5rem 0;
  }

  .services-cta__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .services-cta h2 {
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .services-cta p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.82);
    max-width: 620px;
  }

@media (max-width: 900px) {
    .services-hero__grid,
    .materials-section,
    .faq-section {
      grid-template-columns: 1fr;
    }

    .services-hero__card {
      max-width: 520px;
    }

    .problem-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-feature,
    .service-feature--reverse {
      grid-template-columns: 1fr;
    }

    .service-feature--reverse .service-feature__image {
      order: 0;
    }

    .service-feature__image {
      min-height: 260px;
    }

    .services-cta__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .problem-tabs {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-panel,
    .service-panel--active {
      grid-template-columns: 1fr;
    }

    .service-panel__image {
      min-height: 300px;
      max-height: 360px;
    }

    .service-panel__left {
      padding-right: 0;
    }

    .service-panel__right {
      border-left: 0;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: 2rem;
    }
  }

  @media (max-width: 560px) {
    .services-hero {
      padding: 5rem 0 3.5rem;
    }

    .services-hero__actions .btn,
    .services-cta__actions .btn {
      width: 100%;
      text-align: center;
    }

    .problem-grid {
      grid-template-columns: 1fr;
    }

    .service-feature__content {
      padding: 1.35rem;
    }

    .problem-tabs {
      grid-template-columns: 1fr;
    }

    .problem-tab {
      min-height: 66px;
    }

    .service-panel__content {
      padding: 1.5rem;
    }

    .service-panel__content ul {
      grid-template-columns: 1fr;
    }

    .service-panel__actions .btn {
      width: 100%;
      text-align: center;
    }

    .service-panel {
      padding: 1.5rem;
    }

    .service-panel__right ul {
      grid-template-columns: 1fr;
    }

    .faq-question {
      font-size: 0.95rem;
    }
  }

</style>
