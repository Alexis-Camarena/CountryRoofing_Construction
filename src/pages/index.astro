---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Country Roofing & Construction LLC | West Michigan Roofing Company"
  description="Top-rated roofing contractor in Kalamazoo, MI. Residential & commercial roofing, roof repair, replacement, storm damage repair. Licensed, insured, 15+ years experience. Free estimates — call (269) 303-3604."
  canonical="https://countryroofingandconstruction.com/"
  ogTitle="Country Roofing & Construction LLC"
  ogDescription="A West Michigan Roofing Company You Can Count On. Quality residential and commercial roofing services in Kalamazoo, Barry, Allegan & Van Buren Counties."
>
  <Header />

  <main id="main-content">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <h1>Country Roofing &amp; Construction LLC</h1>
      <p class="hero-sub">A West Michigan Roofing Company You Can Count On.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn--cta">Get A Free Estimate</a>
        <a href="/gallery" class="btn btn--outline">See Our Work</a>
      </div>
      <blockquote class="hero-testimonial">
        <p>"Great group of workers, communication throughout the whole project — there's no stone left unturned. They have done 4 roofs for my family and received the same great result every time. Highly recommended."</p>
        <cite>— Agustin G.</cite>
      </blockquote>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trust-bar">
    <div class="container trust-bar-inner">
      <div class="trust-item">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Licensed &amp; Insured</span>
      </div>
      <div class="trust-item">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>15+ Years Experience</span>
      </div>
      <div class="trust-item">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        <span>Free Estimates</span>
      </div>
      <div class="trust-item">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>Warranty Backed</span>
      </div>
      <div class="trust-item">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        <span>Locally Owned</span>
      </div>
    </div>
  </section>

  <!-- Services Intro -->
  <section class="section">
    <div class="container">
      <div class="services-intro">
        <div class="services-intro-text">
          <h2>Quality Residential and Commercial Roofing Services</h2>
          <p>We offer top-quality residential and commercial roofing services. With a commitment to excellence and years of industry experience, we provide durable, aesthetically pleasing, and reliable roofing solutions tailored to meet the unique needs of both homeowners and businesses. From new installations to comprehensive repairs, our skilled team ensures every project is completed to the highest standards, guaranteeing your satisfaction and the long-lasting protection of your property.</p>
          <a href="/services" class="btn btn--primary mt-3">View All Services</a>
        </div>
        <div class="services-intro-image">
          <img src="/images/a3cf0dcc-e3e4-4fe1-956c-ba7c0da09d4b.jpg" alt="Country Roofing crew working on a residential roof" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Services -->
  <section class="section section--light">
    <div class="container">
      <div class="section-header">
        <h2>What We Do</h2>
        <p>Expert roofing and construction services for homes and businesses across West Michigan.</p>
      </div>
      <div class="service-cards">
        <a href="/services" class="service-card">
          <img src="/images/e1e0edef-f62b-4c22-9e31-484ff9abd5e7.jpg" alt="Construction services" loading="lazy" />
          <div class="service-card-content">
            <h3>Construction</h3>
            <p>Full construction and remodeling services.</p>
          </div>
        </a>
        <a href="/services" class="service-card">
          <img src="/images/ec11a62b-8128-407f-94f3-40beecee40c6.jpg" alt="Roof replacement project" loading="lazy" />
          <div class="service-card-content">
            <h3>Roof Replacement</h3>
            <p>Expert replacement with premium materials.</p>
          </div>
        </a>
        <a href="/services" class="service-card">
          <img src="/images/28446c0c-e7dd-49a4-8e8c-68ae481a1486.jpg" alt="Roof repair in progress" loading="lazy" />
          <div class="service-card-content">
            <h3>Roof Repairs</h3>
            <p>Fast, reliable repair for any roof issue.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>What Customers Are Saying</h2>
      </div>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <div class="stars" role="img" aria-label="5 out of 5 stars"><span aria-hidden="true">★★★★★</span></div>
          <p>"They had the best prices around. Our roof was done very quick and looks amazing. Wouldn't hesitate calling these guys again and highly recommend to anyone looking for exterior renovations."</p>
          <cite>— Jesus C.</cite>
        </div>
        <div class="testimonial-card">
          <div class="stars" role="img" aria-label="5 out of 5 stars"><span aria-hidden="true">★★★★★</span></div>
          <p>"The crew was well organized, polite, and did a fantastic job on my roof. Thank you!"</p>
          <cite>— Jeremy W.</cite>
        </div>
        <div class="testimonial-card">
          <div class="stars" role="img" aria-label="5 out of 5 stars"><span aria-hidden="true">★★★★★</span></div>
          <p>"Country Roofing &amp; Construction did a great job on my exteriors. They are timely and professional people."</p>
          <cite>— Gustavo V.</cite>
        </div>
        <div class="testimonial-card">
          <div class="stars" role="img" aria-label="5 out of 5 stars"><span aria-hidden="true">★★★★★</span></div>
          <p>"Job well done. I would recommend and hire Omar again. His staff were quick and efficient."</p>
          <cite>— Pamela E.</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-banner">
    <div class="cta-overlay"></div>
    <div class="container cta-content">
      <h2>Providing Residential &amp; Commercial Construction Solutions</h2>
      <a href="tel:+12693033604" class="btn btn--cta">CALL NOW: (269) 303-3604</a>
    </div>
  </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    background: url('/images/667aa1e3e39b021f09a8cdf0.jpg') center/cover no-repeat;
    color: var(--color-white);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(15,23,42,0.9) 0%, rgba(30,58,95,0.7) 100%);
  }

  .hero-content {
    position: relative;
    padding: 6rem 0;
    max-width: 800px;
  }

  .hero h1 {
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    opacity: 0.95;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .hero-testimonial {
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(8px);
    border-left: 4px solid var(--color-accent);
    padding: 1.25rem 1.5rem;
    border-radius: 0 8px 8px 0;
    max-width: 600px;
  }

  .hero-testimonial p {
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .hero-testimonial cite {
    font-size: 0.875rem;
    opacity: 0.85;
    font-style: normal;
    font-weight: 600;
  }

  /* Trust Bar */
  .trust-bar {
    background: var(--color-dark);
    color: var(--color-white);
    padding: 1.25rem 0;
    border-top: 3px solid var(--color-accent);
  }

  .trust-bar-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* Services Intro */
  .services-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .services-intro-text p {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    margin-top: 1rem;
  }

  .services-intro-image img {
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.12);
  }

  /* Service Cards */
  .service-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .service-card {
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-white);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
    color: var(--color-text);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    color: var(--color-text);
  }

  .service-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .service-card-content {
    padding: 1.5rem;
  }

  .service-card-content h3 {
    margin-bottom: 0.5rem;
  }

  .service-card-content p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  /* Testimonials */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .testimonial-card {
    background: var(--color-light);
    padding: 2rem;
    border-radius: 8px;
    border-left: 4px solid var(--color-accent);
  }

  .testimonial-card .stars {
    color: var(--color-star);
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .testimonial-card p {
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .testimonial-card cite {
    font-style: normal;
    font-weight: 600;
    color: var(--color-text);
  }

  /* CTA Banner */
  .cta-banner {
    position: relative;
    background: url('/images/667c353cb1f95164e0cfd6df.jpg') center/cover no-repeat;
    padding: 5rem 0;
    text-align: center;
    color: var(--color-white);
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(12, 20, 37, 0.85);
  }

  .cta-content {
    position: relative;
  }

  .cta-content h2 {
    color: var(--color-white);
    margin-bottom: 2rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .services-intro {
      grid-template-columns: 1fr;
    }

    .service-cards {
      grid-template-columns: 1fr;
    }

    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .trust-bar-inner {
      justify-content: center;
    }

    .hero-content {
      padding: 4rem 0;
    }
  }

  @media (max-width: 480px) {
    .hero-content {
      padding: 3rem 0;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
      text-align: center;
    }

    .hero-testimonial {
      padding: 1rem 1.25rem;
    }

    .hero-testimonial p {
      font-size: 0.875rem;
    }

    .trust-item {
      font-size: 0.8rem;
    }

    .trust-item svg {
      width: 22px;
      height: 22px;
    }

    .service-card-content {
      padding: 1rem;
    }

    .testimonial-card {
      padding: 1.25rem;
    }

    .cta-banner {
      padding: 3rem 0;
    }
  }
</style>
