---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header" role="banner">
  <!-- Accent bar -->
  <div class="header-topbar">
    <div class="container topbar-inner">
      <span class="topbar-text">Licensed &amp; Insured · Serving Southwest Michigan · 15+ Years Experience</span>
      <a href="tel:+12693033604" class="topbar-phone">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        (269) 303-3604
      </a>
    </div>
  </div>

  <div class="header-main">
    <div class="header-inner container">
      <a href="/" class="logo-link" aria-label="Country Roofing & Construction LLC — Home">
        <img src="/images/logo.png" alt="Country Roofing & Construction LLC" width="200" height="67" />
      </a>

      <button class="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="main-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="main-nav" id="main-nav" aria-label="Main navigation">
        <ul class="nav-list" role="list">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="nav-actions">
          <a href="https://facebook.com/profile.php?id=61555016512639" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Visit us on Facebook">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="/contact" class="btn btn--accent header-cta">
            Get Free Estimate
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Top accent bar */
  .header-topbar {
    background: var(--color-accent);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0.4rem 0;
  }

  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .topbar-phone {
    color: var(--color-white);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .topbar-phone:hover {
    color: var(--color-white);
    opacity: 0.9;
  }

  .topbar-text {
    opacity: 0.95;
  }

  /* Main header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--color-dark);
  }

  .header-main {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: 2rem;
  }

  .logo-link {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
  }

  .logo-link img {
    height: 65px;
    width: auto;
    filter: brightness(1.1);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 0;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.875rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
  }

  .nav-link:hover {
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-link.active {
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.1);
    position: relative;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0.875rem;
    right: 0.875rem;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .social-link {
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s;
    display: flex;
    align-items: center;
  }

  .social-link:hover {
    color: #1877f2;
  }

  .header-cta {
    padding: 0.625rem 1.5rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
  }

  .mobile-toggle span {
    display: block;
    width: 100%;
    height: 2.5px;
    background: var(--color-white);
    border-radius: 2px;
    transition: all 0.3s;
  }

  .mobile-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 960px) {
    .topbar-text {
      display: none;
    }

    .topbar-inner {
      justify-content: center;
    }

    .mobile-toggle {
      display: flex;
    }

    .main-nav {
      position: fixed;
      top: calc(var(--header-height) + 30px);
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-dark);
      flex-direction: column;
      padding: 2rem;
      gap: 2rem;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
    }

    .main-nav.open {
      transform: translateX(0);
    }

    .nav-list {
      flex-direction: column;
      gap: 0.25rem;
    }

    .nav-link {
      font-size: 1.1rem;
      padding: 0.875rem 1rem;
    }

    .nav-actions {
      flex-direction: column;
      width: 100%;
    }

    .header-cta {
      width: 100%;
      text-align: center;
      padding: 0.875rem 1.5rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .logo-link img {
      height: 50px;
    }

    .header-inner {
      height: 70px;
    }

    .main-nav {
      top: calc(70px + 30px);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.mobile-toggle');
  const nav = document.querySelector('.main-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Close mobile nav when clicking a link
  nav?.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Close mobile nav on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>
