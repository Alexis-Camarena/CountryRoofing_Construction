---
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/images/logo.png" alt="Country Roofing & Construction LLC" width="160" height="54" />
        <p>A West Michigan Roofing Company You Can Count On. Licensed, insured, and serving Southwest Michigan for over 15 years.</p>
        <a href="https://facebook.com/profile.php?id=61555016512639" target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="Visit us on Facebook">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://share.google/ukpMkPnkgfJqEkO99" target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="View our Google Business Profile">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        </a>
      </div>

      <div class="footer-nav">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/gallery">Gallery</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
        </ul>
      </div>

      <div class="footer-services">
        <h4>Our Services</h4>
        <ul>
          <li>Residential Roofing</li>
          <li>Commercial Roofing</li>
          <li>Roof Repair</li>
          <li>Storm Damage Repair</li>
          <li>Roof Replacement</li>
          <li>Siding & Gutters</li>
        </ul>
      </div>

      <div class="footer-contact">
        <h4>Contact Us</h4>
        <ul>
          <li>
            <a href="tel:+12693033604">(269) 303-3604</a>
          </li>
          <li>
            <a href="mailto:269country@gmail.com">269country@gmail.com</a>
          </li>
          <li>Kalamazoo, MI</li>
        </ul>
        <p class="service-areas">Serving Kalamazoo, Barry, Allegan &amp; Van Buren Counties</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Country Roofing & Construction LLC. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: #94a3b8;
    padding: 4rem 0 0;
    border-top: 3px solid var(--color-accent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
  }

  .footer-brand p {
    margin-top: 1rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-brand img {
    height: 50px;
    width: auto;
  }

  .footer-social {
    display: inline-flex;
    margin-top: 1rem;
    color: #c5cdd8;
    transition: color 0.2s;
  }

  .footer-social:hover {
    color: #1877f2;
  }

  h4 {
    color: var(--color-white);
    font-size: 1.05rem;
    margin-bottom: 1rem;
    font-family: var(--font-heading);
  }

  ul {
    list-style: none;
  }

  li {
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  a {
    color: #c5cdd8;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--color-white);
  }

  .service-areas {
    margin-top: 1rem;
    font-size: 0.825rem;
    font-style: italic;
    color: #8d96a3;
  }

  .footer-bottom {
    margin-top: 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    font-size: 0.825rem;
    color: #8d96a3;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
